{
  "name": "whiteboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "turbo run storybook --filter=@whiteboard/ui",
    "db:generate": "pnpm --filter whiteboard-api db:generate",
    "db:migrate": "pnpm --filter whiteboard-api db:migrate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@whiteboard/config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
