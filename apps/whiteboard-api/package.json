{
  "name": "whiteboard-api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "nest start --watch"
  },
  "type": "module",
  "volta": {
    "extends": "../../package.json"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/platform-ws": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "@whiteboard/config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "source-map-support": "^0.5.21",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
